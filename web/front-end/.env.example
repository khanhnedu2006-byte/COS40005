# Copy to .env (optional).

# Back-end API. Leave EMPTY to run in MOCK mode (uses data/od_matrix.csv in the browser, no server needed).
# With a value, the UI calls  <VITE_API_BASE>/api/geocode  and  <VITE_API_BASE>/api/plan  (see docs/API_CONTRACT.md).
# Use a relative base like "" + VITE_API_TARGET below to go through the Vite dev proxy.
VITE_API_BASE=

# Dev proxy target for /api (only used by `npm run dev`). Example: http://localhost:8000
# If you set this, also set VITE_API_BASE=/ (a single slash) so the UI leaves mock mode.
VITE_API_TARGET=

# Map background tiles (optional). Default: Esri World Street Map, then OpenStreetMap.
# VITE_TILE_URL=https://api.tomtom.com/map/1/tile/basic/main/{z}/{x}/{y}.png?key=YOUR_KEY
# VITE_TILE_ATTRIBUTION=&copy; TomTom
